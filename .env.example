# Copy to .env and fill in. Never commit .env.

# ---- Language model (clip picking, B-roll search queries, copy) ----
# Default: free local inference with Ollama (https://ollama.com) and Qwen3 4B.
#   1. Install Ollama, 2. ollama pull qwen3:4b  (~2.5 GB, the only model needed)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Context window in tokens. 0 = sized by clipforge-check for this GPU (12288 on 6 GB VRAM).
OLLAMA_NUM_CTX=0
# How long Ollama keeps the model in VRAM after a request. ClipForge also unloads it before
# GPU transcription so Whisper and the LLM never compete for 6 GB.
OLLAMA_KEEP_ALIVE=2m
OLLAMA_TIMEOUT_SECONDS=900

# B-roll vision check: none (you approve contact sheets yourself) | ollama | anthropic.
# Optional local vision model (extra ~3 GB download): ollama pull qwen2.5vl:3b
VISION_PROVIDER=none
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Optional paid provider. Only used if LLM_PROVIDER=anthropic or VISION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# "default" re-runs a request the model declines on a fallback model; "off" disables that.
ANTHROPIC_FALLBACKS=default

# Transcription. "auto" uses what clipforge-check found on this PC.
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_CHUNK_MINUTES=10

# Diarization: auto | basic | pyannote. pyannote also needs HF_TOKEN and
# `pip install -e backend[pyannote]` (PyTorch, large download).
DIARIZATION_BACKEND=auto
HF_TOKEN=

# Storage and database. Empty DATABASE_URL = SQLite file in DATA_DIR.
# DATA_DIR=C:\ClipForge\data
DATABASE_URL=

API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Extra host names the API answers to (comma-separated). Empty = localhost only, which blocks
# DNS-rebinding attacks from websites you visit. Only add names you control.
ALLOWED_HOSTS=

# ---- B-roll stock footage (free keys; without them only your own uploads are used) ----
# https://www.pexels.com/api/  and  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Learning loop + scheduled YouTube uploads (optional) ----
# Google Cloud console -> APIs & Services -> enable "YouTube Data API v3" and
# "YouTube Analytics API" -> Credentials -> OAuth client ID, type "Desktop app".
# Without these, import a YouTube Studio / vidIQ CSV on the Learning page instead.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LEARNING_DAYS=3

# ---- Disk and rendering ----
# Downloads and renders refuse to start when free space would drop below this.
MIN_FREE_GB=5
MAX_UPLOAD_GB=20
# auto = NVENC when the GPU/driver can encode, else libx264 on the CPU. Or: h264_nvenc | libx264
RENDER_ENCODER=auto

# ---- Advanced (defaults are fine) ----
# PICKER_MAX_RETRIES=2
# OLLAMA_TEMPERATURE=0.2
# WHISPER_CHUNK_OVERLAP_SECONDS=5
# WORKER_POLL_SECONDS=1
# JOB_STALE_SECONDS=300

# Test-only stubs for whisper/diarization/Claude. Never set for real runs.
FAKE_MODELS=false
